# WattWise Frontend Environment Variables
# Copy this file to .env.local and fill in your values before running the frontend

# Required: Backend API URL
# Must point to your running WattWise AI backend
# Local development (default): http://127.0.0.1:8000
# Production: Replace with your deployed backend URL (e.g., https://wattwise-api.onrender.com)
VITE_API_URL=http://127.0.0.1:8000